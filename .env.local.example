# Copy this file to .env.local and fill in your values.

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Find these in: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wedding-photos

# Public URL for your R2 bucket.
# Option A (easiest): Enable "Public Access" on the bucket in Cloudflare dashboard
#   → copy the r2.dev URL shown there, e.g. https://pub-abc123.r2.dev
# Option B: Use a custom domain you've connected in Cloudflare, e.g. https://photos.yourdomain.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── Upload page ───────────────────────────────────────────────────────────────
# Guests must enter this code before they can upload photos. Leave blank to disable.
NEXT_PUBLIC_UPLOAD_PASSWORD=your_guest_code_here

# ── SQLite (RSVP storage) ─────────────────────────────────────────────────────
# Path to the SQLite database file on your server. Defaults to ./wedding.db
# DB_PATH=/var/data/wedding.db
